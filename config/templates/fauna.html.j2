{% extends "base.html.j2" %}

{% block title %}{{ t.fauna_title | default('Fauna Bororo') }}{% endblock %}

{% block content %}
    <header>
        <h1>{{ t.fauna_title | default('Fauna Bororo') }}</h1>
        <p class="subtitle">{{ meta.description }} &mdash; {{ data | length }} {{ t.species_label | default('espécies') }}</p>
    </header>

    <div class="search-container">
        <div class="search-row">
            <input type="text" id="search-input" class="search-input" placeholder="{{ t.fauna_search_placeholder | default('Pesquisar...') }}" autocomplete="off" aria-label="{{ t.search_label | default('Pesquisar') }}">
            <select id="category-filter" class="filter-select" aria-label="{{ t.filter_label | default('Filtrar resultados') }}">
                <option value="">{{ t.fauna_filter_all | default('Todas as categorias') }}</option>
                {% set categories = [] %}
                {% for item in data %}
                    {% if item.classification_bororo and item.classification_bororo not in categories %}
                        {% set _ = categories.append(item.classification_bororo) %}
                    {% endif %}
                {% endfor %}
                {% for cat in categories | sort %}
                <option value="{{ cat }}">{{ cat }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="stats" id="stats" aria-live="polite"></div>
    </div>

    <div class="results-container" id="results" aria-live="polite">
        <div class="empty-state">
            <h2>{{ t.fauna_empty_title | default('Pesquise a fauna') }}</h2>
            <p>{{ t.fauna_empty_text | default('') }}</p>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script src="https://cdn.jsdelivr.net/npm/fuse.js@7.0.0/dist/fuse.min.js"></script>

    <script>
    var T = {{ t | tojson }};

    initSearchPage({
        data: {{ data | tojson }},
        fuseKeys: [
            { name: 'name_bororo', weight: 2 },
            { name: 'name_portuguese', weight: 1.5 },
            { name: 'scientific_name', weight: 1 },
            { name: 'category', weight: 0.5 },
            { name: 'classification_bororo', weight: 0.5 },
            { name: 'info', weight: 0.5 }
        ],
        filterField: 'classification_bororo',
        filterElementId: 'category-filter',
        renderEntry: function(entry, matchMap) {
            var html = '<div class="entry">';

            html += '<div class="entry-header">';
            html += '<span class="entry-word" lang="bor">' + highlightMatches(entry.name_bororo, matchMap['name_bororo']) + '</span>';
            if (entry.name_portuguese) {
                html += '<span class="entry-secondary">&mdash; ' + highlightMatches(entry.name_portuguese, matchMap['name_portuguese']) + '</span>';
            }
            if (entry.classification_bororo) {
                html += '<span class="entry-tag">' + escapeHtml(entry.classification_bororo) + '</span>';
            }
            html += '</div>';

            if (entry.scientific_name) {
                html += '<p class="entry-scientific"><em>' + highlightMatches(entry.scientific_name, matchMap['scientific_name']) + '</em></p>';
            }
            if (entry.category) {
                html += '<p class="entry-definition">' + T.fauna_family + ': ' + highlightMatches(entry.category, matchMap['category']) + '</p>';
            }
            if (entry.info) {
                html += '<div class="entry-comment">' + highlightMatches(entry.info, matchMap['info']) + '</div>';
            }
            if (entry._linked_dictionary && entry._linked_dictionary.length > 0) {
                html += '<div class="entry-links" style="margin-top:0.5rem">';
                html += '<strong>' + T.see_in_dictionary + ':</strong> ';
                html += entry._linked_dictionary.map(function(d) {
                    return '<a href="dictionary.html?search=' + encodeURIComponent(d.entry) + '">' + escapeHtml(d.entry) + '</a>';
                }).join(', ');
                html += '</div>';
            }

            if (entry.pic_link) {
                html += '<div class="entry-media">';
                html += '<a href="' + escapeHtml(entry.pic_link) + '" target="_blank" rel="noopener">';
                html += '<img class="entry-thumbnail" src="' + escapeHtml(entry.pic_link) + '" alt="' + escapeHtml(entry.name_bororo) + '" loading="lazy" onerror="this.style.display=\'none\'">';
                html += '</a>';
                html += '</div>';
            }

            html += '</div>';
            return html;
        },
        labels: {
            results: function(n) { return n !== 1 ? T.fauna_result_plural : T.fauna_result_singular; },
            emptyTitle: T.fauna_empty_title,
            emptyText: T.fauna_empty_text,
            noResults: T.fauna_no_results,
            noResultsHint: T.fauna_no_results_hint,
            overflow: function(n) { return T.fauna_overflow.replace('{n}', n); }
        }
    });
    </script>
{% endblock %}
