{% extends "base.html.j2" %}

{% block title %}{{ t.dict_title | default('Dicionário Bororo') }}{% endblock %}

{% block extra_styles %}
        .entry-audio {
            margin-top: 0.5rem;
            display: flex;
            flex-direction: column;
            gap: 0.35rem;
        }
        .audio-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .audio-speaker {
            font-size: 0.8rem;
            color: #666;
            min-width: 5em;
        }
        .audio-item audio {
            height: 28px;
            flex: 1;
            max-width: 260px;
        }
        .loading-state {
            padding: 3rem;
            text-align: center;
            color: #888;
        }
{% endblock %}

{% block content %}
    <header>
        <h1>{{ t.dict_title | default('Dicionário Bororo') }}</h1>
        <p class="subtitle">{{ meta.description }} &mdash; {{ meta.record_count }} {{ t.entries_label | default('entradas') }}</p>
    </header>

    <div class="search-container">
        <div class="search-row">
            <input type="text" id="search-input" class="search-input" placeholder="{{ t.dict_search_placeholder | default('Pesquisar...') }}" autocomplete="off" disabled aria-label="{{ t.search_label | default('Pesquisar') }}">
            <select id="pos-filter" class="filter-select" disabled aria-label="{{ t.filter_label | default('Filtrar resultados') }}">
                <option value="">{{ t.dict_filter_all | default('Todas as classes') }}</option>
            </select>
        </div>
        <div class="stats" id="stats" aria-live="polite"></div>
    </div>

    <div class="results-container" id="results" aria-live="polite">
        <div class="loading-state" id="loading">
            {{ t.dict_loading | default('Carregando dicionário...') }}
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script src="https://cdn.jsdelivr.net/npm/fuse.js@7.0.0/dist/fuse.min.js"></script>

    <script>
    var T = {{ t | tojson }};
    var posLabels = {};
    ['LEX','S','VC','ADV','PPASS','POSP','SUF','INTJ','VT','PRON','V','PRCL','PPAS','PPART','NUM','IP','DEM','CONJ','X','PROPN'].forEach(function(k) {
        posLabels[k] = T['pos_' + k] || k;
    });

    fetch('{{ base_path | default("") }}dictionary-data.json')
        .then(function(r) { return r.json(); })
        .then(function(json) {
            var posTypes = {};
            json.data.forEach(function(item) {
                if (item.pos) posTypes[item.pos] = true;
            });
            var posFilter = document.getElementById('pos-filter');
            Object.keys(posTypes).sort().forEach(function(pos) {
                var opt = document.createElement('option');
                opt.value = pos;
                opt.textContent = pos;
                posFilter.appendChild(opt);
            });

            document.getElementById('search-input').disabled = false;
            posFilter.disabled = false;

            document.getElementById('results').innerHTML =
                '<div class="empty-state">' +
                '<h2>' + T.dict_empty_title + '</h2>' +
                '<p>' + T.dict_empty_text + '</p>' +
                '</div>';

            initSearchPage({
                data: json.data,
                fuseKeys: [
                    { name: 'entry', weight: 2 },
                    { name: 'definition', weight: 1.5 },
                    { name: 'example_sent', weight: 1 },
                    { name: 'comment', weight: 0.5 },
                    { name: 'ipa', weight: 0.5 },
                    { name: 'scientific_name', weight: 0.5 }
                ],
                filterField: 'pos',
                filterElementId: 'pos-filter',
                renderEntry: function(entry, matchMap) {
                    var html = '<div class="entry">';

                    html += '<div class="entry-header">';
                    html += '<span class="entry-word" lang="bor">' + highlightMatches(entry.entry, matchMap['entry']) + '</span>';
                    if (entry.ipa) {
                        html += '<span class="entry-ipa">[' + highlightMatches(entry.ipa, matchMap['ipa']) + ']</span>';
                    }
                    if (entry.pos) {
                        html += '<span class="entry-tag">' + escapeHtml(posLabels[entry.pos] || entry.pos) + '</span>';
                    }
                    html += '</div>';

                    if (entry.definition) {
                        html += '<p class="entry-definition">' + highlightMatches(entry.definition, matchMap['definition']) + '</p>';
                    }
                    if (entry.example_sent) {
                        html += '<p class="entry-example">' + highlightMatches(entry.example_sent, matchMap['example_sent']) + '</p>';
                    }
                    if (entry.scientific_name) {
                        html += '<p class="entry-scientific">' + T.dict_scientific_name + ': <em>' + highlightMatches(entry.scientific_name, matchMap['scientific_name']) + '</em></p>';
                    }
                    if (entry.comment) {
                        html += '<div class="entry-comment">' + highlightMatches(entry.comment, matchMap['comment']) + '</div>';
                    }

                    if (entry.audio && entry.audio.length > 0) {
                        html += '<div class="entry-audio">';
                        for (var i = 0; i < entry.audio.length; i++) {
                            var a = entry.audio[i];
                            var mimeType = a.format === 'webm' ? 'audio/webm' : 'audio/wav';
                            var speaker = a.speaker.charAt(0).toUpperCase() + a.speaker.slice(1);
                            html += '<div class="audio-item">';
                            html += '<span class="audio-speaker">' + escapeHtml(speaker) + '</span>';
                            html += '<audio controls preload="none"><source src="{{ base_path | default("") }}recordings/' + escapeHtml(a.file_path) + '" type="' + mimeType + '"></audio>';
                            html += '</div>';
                        }
                        html += '</div>';
                    }

                    if (entry._linked_fauna && entry._linked_fauna.length > 0) {
                        html += '<div class="entry-links" style="margin-top:0.5rem">';
                        html += '<strong>' + T.see_in_fauna + ':</strong> ';
                        html += entry._linked_fauna.map(function(f) {
                            return '<a href="fauna.html?search=' + encodeURIComponent(f.name_bororo) + '">' + escapeHtml(f.name_bororo) + '</a>';
                        }).join(', ');
                        html += '</div>';
                    }

                    if (entry.pic_link || entry.wiki_link) {
                        html += '<div class="entry-media">';
                        if (entry.pic_link) {
                            html += '<a href="' + escapeHtml(entry.pic_link) + '" target="_blank" rel="noopener">';
                            html += '<img class="entry-thumbnail" src="' + escapeHtml(entry.pic_link) + '" alt="' + escapeHtml(entry.entry) + '" loading="lazy" onerror="this.style.display=\'none\'">';
                            html += '</a>';
                        }
                        html += '<div class="entry-links">';
                        if (entry.wiki_link) {
                            html += '<a href="' + escapeHtml(entry.wiki_link) + '" target="_blank" rel="noopener">Wikipedia</a>';
                        }
                        html += '</div>';
                        html += '</div>';
                    }

                    html += '</div>';
                    return html;
                },
                labels: {
                    results: function(n) { return n !== 1 ? T.dict_result_plural : T.dict_result_singular; },
                    emptyTitle: T.dict_empty_title,
                    emptyText: T.dict_empty_text,
                    noResults: T.dict_no_results,
                    noResultsHint: T.dict_no_results_hint,
                    overflow: function(n) { return T.dict_overflow.replace('{n}', n); }
                }
            });
        });
    </script>
{% endblock %}
