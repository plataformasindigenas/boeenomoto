{% extends "base.html.j2" %}

{% block title %}{{ t.enc_title | default('Enciclopédia Bororo') }}{% endblock %}

{% block extra_styles %}
.entry {
    transition: background 0.2s;
}
.entry:hover {
    background: #f8f9fa;
}
.entry-header {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.25rem;
}
.entry-word {
    font-size: 1.25rem;
    font-weight: 600;
    color: #3D352F;
}
.entry-word a {
    color: inherit;
    text-decoration: none;
}
.entry-word a:hover {
    color: #C75B39;
    text-decoration: underline;
}
.entry-type-tag {
    font-size: 0.7rem;
    background: #E8DFD5;
    color: #6B6B6B;
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
}
.entry-summary {
    color: #555;
    font-size: 0.95rem;
    margin: 0;
    line-height: 1.5;
}
.entry-categories {
    margin-top: 0.35rem;
    display: flex;
    gap: 0.25rem;
    flex-wrap: wrap;
}
.entry-cat {
    font-size: 0.72rem;
    background: #E8E4DF;
    color: #555;
    padding: 0.12rem 0.4rem;
    border-radius: 3px;
    cursor: pointer;
}
.entry-cat:hover {
    background: #D8D4CF;
}
.entry-variants {
    font-size: 0.85rem;
    color: #888;
    margin-top: 0.2rem;
}
.variant-tag {
    background: #E8E4DF;
    padding: 0.1rem 0.5rem;
    border-radius: 3px;
    margin-right: 0.3rem;
    font-style: italic;
}
.category-tree {
    margin-bottom: 1rem;
    background: #FAF8F5;
    border: 1px solid #E8E4DF;
    border-radius: 4px;
    padding: 0.75rem 1rem;
}
.category-tree summary {
    cursor: pointer;
    font-weight: 600;
    color: #3D352F;
    font-size: 0.95rem;
}
.category-tree ul {
    list-style: none;
    padding-left: 1rem;
    margin: 0.25rem 0;
}
.category-tree li {
    padding: 0.15rem 0;
}
.category-tree a {
    color: #C75B39;
    text-decoration: none;
    font-size: 0.9rem;
}
.category-tree a:hover {
    text-decoration: underline;
}
.category-tree .cat-count {
    font-size: 0.8rem;
    color: #888;
}
.loading-state {
    padding: 3rem;
    text-align: center;
    color: #888;
}
{% endblock %}

{% block content %}
    <header>
        <h1>{{ t.enc_title | default('Enciclopédia Bororo') }}</h1>
        <p class="subtitle">{{ meta.description }} &mdash; {{ meta.record_count }} {{ t.articles_label | default('verbetes') }}</p>
    </header>

    <div class="search-container">
        <div class="search-row">
            <input type="text" id="search-input" class="search-input" placeholder="{{ t.enc_search_placeholder | default('Pesquisar...') }}" autocomplete="off" disabled aria-label="{{ t.search_label | default('Pesquisar') }}">
            <select id="keyword-filter" class="filter-select" disabled aria-label="{{ t.filter_label | default('Filtrar resultados') }}">
                <option value="">{{ t.enc_filter_all | default('Todas as categorias') }}</option>
                <option value="__uncategorized__">{{ t.enc_filter_uncategorized | default('Sem categoria') }}</option>
            </select>
        </div>
        <div class="stats" id="stats" aria-live="polite"></div>
    </div>

    <div id="category-tree-container"></div>

    <div class="results-container" id="results" aria-live="polite">
        <div class="loading-state" id="loading">
            {{ t.enc_loading | default('Carregando enciclopédia...') }}
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script src="https://cdn.jsdelivr.net/npm/fuse.js@7.0.0/dist/fuse.min.js"></script>

    <script>
    var T = {{ t | tojson }};

    function hasCategory(entry, value) {
        if (value === '__uncategorized__') return !entry.categories || entry.categories.length === 0;
        return entry.categories && entry.categories.some(function(cat) {
            return cat === value || cat.indexOf(value + '/') === 0;
        });
    }

    function attachCategoryFilters() {
        document.querySelectorAll('.entry-cat').forEach(function(el) {
            el.addEventListener('click', function(e) {
                e.stopPropagation();
                var cat = this.getAttribute('data-category');
                if (cat) {
                    var kwFilter = document.getElementById('keyword-filter');
                    // Add option if not present
                    var found = false;
                    for (var i = 0; i < kwFilter.options.length; i++) {
                        if (kwFilter.options[i].value === cat) { found = true; break; }
                    }
                    if (!found) {
                        var opt = document.createElement('option');
                        opt.value = cat;
                        opt.textContent = cat;
                        kwFilter.appendChild(opt);
                    }
                    kwFilter.value = cat;
                    kwFilter.dispatchEvent(new Event('change'));
                }
            });
        });
    }

    function renderCategoryTree(tree, prefix) {
        var keys = Object.keys(tree).filter(function(k) { return k !== '_count'; }).sort();
        if (keys.length === 0) return '';
        var html = '<ul>';
        keys.forEach(function(key) {
            var path = prefix ? prefix + '/' + key : key;
            var node = tree[key];
            var count = node._count || 0;
            var subKeys = Object.keys(node).filter(function(k) { return k !== '_count'; });
            html += '<li>';
            html += '<a href="?category=' + encodeURIComponent(path) + '" data-cat-path="' + escapeHtml(path) + '">';
            html += escapeHtml(key) + ' <span class="cat-count">(' + count + ')</span></a>';
            if (subKeys.length > 0) {
                html += renderCategoryTree(node, path);
            }
            html += '</li>';
        });
        html += '</ul>';
        return html;
    }

    fetch('{{ base_path | default("") }}encyclopedia-data.json')
        .then(function(r) { return r.json(); })
        .then(function(json) {
            // Populate category filter dropdown from flat categories
            var categories = {};
            json.data.forEach(function(item) {
                if (item.categories) item.categories.forEach(function(cat) { categories[cat] = true; });
            });
            var kwFilter = document.getElementById('keyword-filter');
            Object.keys(categories).sort().forEach(function(cat) {
                var opt = document.createElement('option');
                opt.value = cat;
                opt.textContent = cat;
                kwFilter.appendChild(opt);
            });

            // Render category tree if available
            if (json.category_tree) {
                var treeHtml = '<details class="category-tree"><summary>' +
                    (T.enc_categories || 'Categorias') + '</summary>' +
                    renderCategoryTree(json.category_tree, '') + '</details>';
                document.getElementById('category-tree-container').innerHTML = treeHtml;

                // Attach click handlers to category tree links
                document.querySelectorAll('.category-tree a[data-cat-path]').forEach(function(el) {
                    el.addEventListener('click', function(e) {
                        e.preventDefault();
                        var path = this.getAttribute('data-cat-path');
                        // Add option to select if not present
                        var found = false;
                        for (var i = 0; i < kwFilter.options.length; i++) {
                            if (kwFilter.options[i].value === path) { found = true; break; }
                        }
                        if (!found) {
                            var opt = document.createElement('option');
                            opt.value = path;
                            opt.textContent = path;
                            kwFilter.appendChild(opt);
                        }
                        kwFilter.value = path;
                        kwFilter.dispatchEvent(new Event('change'));
                    });
                });
            }

            document.getElementById('search-input').disabled = false;
            kwFilter.disabled = false;
            document.getElementById('results').innerHTML =
                '<div class="empty-state"><h2>' + T.enc_empty_title + '</h2><p>' + T.enc_empty_text + '</p></div>';

            initSearchPage({
                data: json.data,
                fuseKeys: [
                    { name: 'title', weight: 2 },
                    { name: 'abstract', weight: 1.5 },
                    { name: 'categories', weight: 1 },
                    { name: 'variants', weight: 0.5 }
                ],
                filterField: null,
                filterElementId: 'keyword-filter',
                filterFn: hasCategory,
                renderEntry: function(entry, matchMap) {
                    var html = '<div class="entry">';
                    html += '<div class="entry-header">';
                    html += '<span class="entry-word"><a href="encyclopedia/' + encodeURIComponent(entry.id) + '.html">' + highlightMatches(entry.title, matchMap['title']) + '</a></span>';
                    if (entry.entry_type) {
                        html += '<span class="entry-type-tag">' + escapeHtml(entry.entry_type) + '</span>';
                    }
                    html += '</div>';

                    if (entry.abstract) {
                        html += '<p class="entry-summary">' + highlightMatches(entry.abstract, matchMap['abstract']) + '</p>';
                    }

                    if (entry.variants && entry.variants.length > 0) {
                        html += '<div class="entry-variants">';
                        entry.variants.forEach(function(v) {
                            html += '<span class="variant-tag">' + escapeHtml(v) + '</span>';
                        });
                        html += '</div>';
                    }

                    if (entry.categories && entry.categories.length > 0) {
                        html += '<div class="entry-categories">';
                        entry.categories.forEach(function(cat) {
                            html += '<span class="entry-cat" data-category="' + escapeHtml(cat) + '">' + escapeHtml(cat) + '</span>';
                        });
                        html += '</div>';
                    }

                    html += '</div>';
                    return html;
                },
                onResults: attachCategoryFilters,
                labels: {
                    results: function(n) { return n !== 1 ? T.enc_result_plural : T.enc_result_singular; },
                    emptyTitle: T.enc_empty_title,
                    emptyText: T.enc_empty_text,
                    noResults: T.enc_no_results,
                    noResultsHint: T.enc_no_results_hint,
                    overflow: function(n) { return T.enc_overflow.replace('{n}', n); }
                }
            });

            // Support ?category= URL parameter
            var urlParams = new URLSearchParams(window.location.search);
            var catParam = urlParams.get('category');
            if (catParam) {
                kwFilter.value = catParam;
                kwFilter.dispatchEvent(new Event('change'));
            }
        });
    </script>
{% endblock %}
